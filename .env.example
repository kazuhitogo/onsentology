# `.env` のテンプレート。コピーして自分の値を入れる。
#   cp .env.example .env
# `.env` は git 管理外。既にシェルで export している環境変数は上書きしない。

# AWS 認証（onsen ask を使う場合のみ必要）
AWS_PROFILE=your-profile
AWS_REGION=ap-northeast-1

# 使うモデル。未設定なら既定の jp.anthropic.claude-sonnet-4-6 を使う。
# アカウント固有のアプリケーション推論プロファイルを使うなら ARN を書く。
#ONSEN_BEDROCK_MODEL_ID=arn:aws:bedrock:ap-northeast-1:<account-id>:application-inference-profile/xxxxxxxx
