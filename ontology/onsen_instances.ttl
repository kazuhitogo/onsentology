    onsen:hasSpringSource oid:src-naruko-takinoyu ;
    onsen:hasBath oid:bath-takinoyu-1 , oid:bath-takinoyu-2 ;
    rdfs:comment "鳴子温泉神社の御神湯とされる共同浴場。"@ja ;
    dcterms:source <https://narukoonsenkyo.web.fc2.com/takinoyu/index.html> .

