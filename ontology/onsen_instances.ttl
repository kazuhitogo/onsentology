#################################################################
#    下呂温泉 — アルカリ性単純温泉の代表例
#################################################################

oid:src-gero-mori a onsen:SpringSource ;
    rdfs:label "下呂温泉（湯之島・森地区）"@ja ;
    onsen:locatedInArea oid:area-gero ;
    onsen:displayedQualityName "単純温泉（アルカリ性単純温泉）" ;
    onsen:hasQualityFromName onsen:SimpleSpring ;
    onsen:pH 9.2 ;
    onsen:dataStatus "源泉温度は未確認（公式サイトの温泉分析表PDFは画像PDFのため数値抽出不可）。" ;
    rdfs:comment """pH9.2 ≧ 8.5 のため「アルカリ性単純温泉」と称される。日本三名泉（下呂・有馬・草津）のひとつ。
強酸性泉のあとの仕上げ湯として推論上有力な候補になる。"""@ja ;
    dcterms:source <https://www.gero-spa.com/onsen/> .

