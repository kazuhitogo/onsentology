#################################################################
#    箱根 大涌谷 — 造成泉
#################################################################

oid:src-owakudani a onsen:SpringSource ;
    rdfs:label "大涌谷温泉（自噴）"@ja ;
    onsen:locatedInArea oid:area-hakone-owakudani ;
    onsen:sourceTemperature 64.7 ;
    onsen:dissolvedSolids 1013.0 ;
    onsen:hydrogenIon 1.27 ;
    onsen:hasQuality onsen:AcidicSpring ;
    onsen:measurementPoint onsen:AtSourceOutlet ;
    rdfs:comment """水素イオン1.27mg/kg ≧ 1mg/kg なので酸性泉の基準を満たす。
溶存物質1,013mg/kg は療養泉の基準（1,000mg/kg以上）を満たし、かつ低張性（8,000mg/kg未満）。
成分値から泉質と3分類軸を推論できる、データセット中唯一の源泉。
したがって泉質名の表記ではなく成分値による判定なので、onsen:hasQuality を直接主張している唯一の源泉でもある。"""@ja ;
    dcterms:source <http://www.hakoneonsen.com/definition.html> .

oid:src-hakone-line1 a onsen:SpringSource ;
    rdfs:label "箱根温泉供給 1号線 造成泉"@ja ;
    onsen:locatedInArea oid:area-hakone-owakudani ;
    onsen:displayedQualityName "酸性-カルシウム-硫酸塩温泉" ;
    onsen:legacyQualityName "酸性-石膏泉" ;
