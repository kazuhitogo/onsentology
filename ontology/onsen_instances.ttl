@prefix onsen: <https://example.org/onsen#> .
@prefix oid:   <https://example.org/onsen/id/> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

#################################################################
#
#  温泉オントロジー: 実データ（インスタンス）
#
#  15温泉地・27源泉・15施設・9浴槽。数値はすべて施設運営者・自治体・観光協会・
#  温泉供給事業者の公式サイトに記載された値のみを転記している。
#  公式サイトに記載がなかった項目は、値を推測せず onsen:dataStatus で
#  「未確認」と明示している（欠損は述語を持たないことで表現する）。
#
#  出典の詳細は docs/research-onsen-data.md（出典ID S1〜S35）を参照。
#
#################################################################

#################################################################
#    温泉地
#################################################################

oid:area-kusatsu a onsen:OnsenArea ; rdfs:label "草津温泉"@ja ; onsen:prefecture "群馬県" .
oid:area-arima a onsen:OnsenArea ; rdfs:label "有馬温泉"@ja ; onsen:prefecture "兵庫県" .
oid:area-beppu-kannawa a onsen:OnsenArea ; rdfs:label "別府温泉郷（鉄輪）"@ja ; onsen:prefecture "大分県" .
oid:area-beppu-myoban a onsen:OnsenArea ; rdfs:label "別府温泉郷（明礬）"@ja ; onsen:prefecture "大分県" .
oid:area-hakone-owakudani a onsen:OnsenArea ; rdfs:label "箱根温泉（大涌谷）"@ja ; onsen:prefecture "神奈川県" .
oid:area-noboribetsu a onsen:OnsenArea ; rdfs:label "登別温泉"@ja ; onsen:prefecture "北海道" .
oid:area-tamagawa a onsen:OnsenArea ; rdfs:label "玉川温泉"@ja ; onsen:prefecture "秋田県" .
oid:area-sukayu a onsen:OnsenArea ; rdfs:label "酸ヶ湯温泉"@ja ; onsen:prefecture "青森県" .
oid:area-manza a onsen:OnsenArea ; rdfs:label "万座温泉"@ja ; onsen:prefecture "群馬県" .
oid:area-shirahone a onsen:OnsenArea ; rdfs:label "白骨温泉"@ja ; onsen:prefecture "長野県" .
oid:area-shima a onsen:OnsenArea ; rdfs:label "四万温泉"@ja ; onsen:prefecture "群馬県" .
oid:area-nagayu a onsen:OnsenArea ; rdfs:label "長湯温泉"@ja ; onsen:prefecture "大分県" .
oid:area-naruko a onsen:OnsenArea ; rdfs:label "鳴子温泉"@ja ; onsen:prefecture "宮城県" .
oid:area-gero a onsen:OnsenArea ; rdfs:label "下呂温泉"@ja ; onsen:prefecture "岐阜県" .
oid:area-misasa a onsen:OnsenArea ; rdfs:label "三朝温泉"@ja ; onsen:prefecture "鳥取県" .

#################################################################
#    草津温泉 — 同一温泉地で源泉ごとにpHが異なる典型例
#################################################################

oid:src-kusatsu-yubatake a onsen:SpringSource ;
    rdfs:label "湯畑源泉"@ja ;
    onsen:locatedInArea oid:area-kusatsu ;
    onsen:displayedQualityName "酸性硫黄泉" ;
    onsen:hasQualityFromName onsen:AcidicSpring , onsen:SulfurSpring ;
    onsen:pH 2.08 ;
    onsen:measurementPoint onsen:AtSourceOutlet ;
    onsen:flowRate 4000 ;
    onsen:dataStatus """源泉温度は未確認。草津町は「万代源泉以外の源泉は温度50℃前後で湧出している」と温泉地全体について記述しているが、
湯畑源泉個別の値ではないため源泉温度は設定していない。
pHは御座之湯の公表値2.08を採用したが、観光協会は同源泉を2.1／2.05とも表記している。""" ;
    dcterms:source <http://onsen-kusatsu.com/gozanoyu/hot-spring/> , <https://www.kusatsu-onsen.ne.jp/onsen/> ,
        <https://www.town.kusatsu.gunma.jp/www/contents/1485254967207/index.html> .

oid:src-kusatsu-bandai a onsen:SpringSource ;
    rdfs:label "万代源泉"@ja ;
    onsen:locatedInArea oid:area-kusatsu ;
    onsen:displayedQualityName "酸性塩化物硫酸塩温泉" ;
    onsen:hasQualityFromName onsen:AcidicSpring , onsen:ChlorideSpring , onsen:SulfateSpring ;
    onsen:pH 1.7 ;
    onsen:sourceTemperature 94.0 ;
    onsen:measurementPoint onsen:AtSourceOutlet ;
    onsen:dataStatus """湧出温度は西の河原露天風呂の公式表記「94〜95度」の下限値を採用。草津町は同源泉を「約94.5℃」と公表しており、
出典によって表記が異なる。溶存物質量は未確認のため、陰イオン主成分による塩化物泉／硫酸塩泉の細別は掲示泉質名からの読み取りである
（onsen:hasQualityFromName）。""" ;
    rdfs:comment """草津町は「万代源泉は約94.5℃と高温のため、プレート式熱交換器を使用し水道水と熱交換して温度を約60℃に下げたものを浴場に利用」と説明している。
熱交換は温泉に水を混ぜないので法定4類型の「加水」には当たらない。温度調整の手段と加水は別概念である。"""@ja ;
    dcterms:source <http://onsen-kusatsu.com/sainokawara/hot-spring/> ,
        <https://www.town.kusatsu.gunma.jp/www/contents/1485254967207/index.html> .

oid:src-kusatsu-nigawa a onsen:SpringSource ;
    rdfs:label "煮川源泉"@ja ;
    onsen:locatedInArea oid:area-kusatsu ;
    onsen:displayedQualityName "酸性硫黄泉" ;
    onsen:hasQualityFromName onsen:AcidicSpring , onsen:SulfurSpring ;
    onsen:pH 2.1 ;
    onsen:measurementPoint onsen:AtSourceOutlet ;
    onsen:dataStatus """源泉温度は未確認（公式サイトは「高温」との記載のみ。草津町は「万代源泉以外の源泉は温度50℃前後で湧出」と
温泉地全体について記述するが、煮川源泉個別の値ではない）。""" ;
    dcterms:source <http://onsen-kusatsu.com/ohtakinoyu/hot-spring/> ,
        <https://www.town.kusatsu.gunma.jp/www/contents/1485254967207/index.html> .

oid:fac-gozanoyu a onsen:Facility ;
    rdfs:label "御座之湯"@ja ;
    onsen:locatedInArea oid:area-kusatsu ;
    onsen:address "群馬県吾妻郡草津町大字草津421" ;
    onsen:hasSpringSource oid:src-kusatsu-yubatake , oid:src-kusatsu-bandai ;
    onsen:claimsKakenagashi true ;
    rdfs:comment "湯畑源泉と万代源泉の2源泉を木之湯／石之湯で使い分ける。1施設が複数源泉を持つ例。"@ja ;
    onsen:dataStatus "加水・加温・循環ろ過・消毒の個別掲示内容は未確認（公式サイトは「源泉かけ流し」の記載のみ）。" ;
    dcterms:source <http://onsen-kusatsu.com/gozanoyu/hot-spring/> .

oid:fac-sainokawara a onsen:Facility ;
    rdfs:label "西の河原露天風呂"@ja ;
    onsen:locatedInArea oid:area-kusatsu ;
    onsen:address "群馬県吾妻郡草津町大字草津521-3" ;
    onsen:hasSpringSource oid:src-kusatsu-bandai ;
    onsen:claimsKakenagashi true ;
    dcterms:source <http://onsen-kusatsu.com/sainokawara/hot-spring/> .

oid:fac-ohtakinoyu a onsen:Facility ;
    rdfs:label "大滝乃湯"@ja ;
    onsen:locatedInArea oid:area-kusatsu ;
    onsen:address "群馬県吾妻郡草津町大字草津596-13" ;
    onsen:hasSpringSource oid:src-kusatsu-nigawa ;
    onsen:claimsKakenagashi true ;
    onsen:declaresTreatment [
        a onsen:TreatmentDeclaration ;
        onsen:treatmentType onsen:AddingWater ;
        onsen:isApplied false ;
        onsen:reason "合わせ湯は加水せず自然冷却で温度差をつくる" ] ;
    dcterms:source <http://onsen-kusatsu.com/ohtakinoyu/hot-spring/> .

#################################################################
#    有馬温泉 — 「かけ流し」と加水・加温・消毒は排他ではない
#################################################################

oid:src-arima-kinsen a onsen:SpringSource ;
    rdfs:label "有馬 金泉"@ja ;
    onsen:locatedInArea oid:area-arima ;
    onsen:displayedQualityName "含鉄-ナトリウム-塩化物強塩高温泉" ;
    onsen:hasQualityFromName onsen:IronSpring , onsen:ChlorideSpring ;
    onsen:temperatureClass onsen:HighTemperatureSpring ;
    onsen:sourceTemperature 99.4 ;
    onsen:measurementPoint onsen:AtSourceOutlet ;
    onsen:mainAnion "Cl-" ;
    onsen:mainCation "Na+" ;
    onsen:dataStatus """源泉温度は神戸市が公表する天神泉源の泉温99.4℃を採用した。神戸市は「（金の湯）の温泉もここから引湯しています」と明記している。
pH は施設・神戸市いずれも公表しておらず未確認。神戸市の他の市有泉源の泉温は妬泉源100.5℃・極楽泉源98.1℃・御所泉源63.9℃で、
金の湯の浴槽は加水・加温を実施しているため浴槽温度はこれらと一致しない。泉温区分は掲示泉質名の「高温泉」から読み取った。""" ;
    dcterms:source <https://arimaspa-kingin.jp/kin-01.htm> ,
        <https://www.city.kobe.lg.jp/a64051/arimasengen.html> .

oid:src-arima-ginsen-co2 a onsen:SpringSource ;
    rdfs:label "有馬 銀泉（炭酸泉）"@ja ;
    onsen:locatedInArea oid:area-arima ;
    onsen:displayedQualityName "単純二酸化炭素冷鉱泉" ;
    onsen:hasQualityFromName onsen:CarbonDioxideSpring ;
    onsen:temperatureClass onsen:ColdMineralSpring ;
    onsen:pH 4.3 ;
    onsen:sourceTemperature 18.3 ;
    onsen:measurementPoint onsen:AtSourceOutlet ;
    onsen:analysisDate "2019-10-25"^^xsd:date ;
    onsen:dataStatus """pH・泉温・分析年月日は神戸市が公表する炭酸泉源の「温泉の掲示内容」（掲示基準に沿った掲示そのもの）から転記した。
湧出地は神戸市北区有馬町杉ヶ谷1325-1（炭酸泉源）＝ゆう出口ベース。分析者は公益財団法人中央温泉研究所（14健地衛第1号）、
決定年月日 2021-03-10・決定者 神戸市。同掲示の泉質名は「含二酸化炭素・鉄－単純冷鉱泉（低張性、弱酸性、冷鉱泉）」で、
銀の湯の施設掲示「単純二酸化炭素冷鉱泉」と一致しない。掲示名からの読み取りで含鉄を足すことはせず、施設掲示の泉質を維持した。
掲示には蒸発残留物（110℃）0.422g／kg、ラドン23.3Bq／kg、密度0.9987g／cm³ の記載もあるが、
蒸発残留物は溶存物質総量と同一の指標ではないため浸透圧区分の判定には用いていない。
飲用の含有成分別禁忌症として「1日に250mL（よう化物イオンの含有量から算出される限界）を超えて飲用する場合：甲状腺機能亢進症」が掲示されている。""" ;
    dcterms:source <https://arimaspa-kingin.jp/gin-01.htm> ,
        <https://www.city.kobe.lg.jp/a64051/kanko/leisure/tansansen.html> ,
        <https://www.city.kobe.lg.jp/documents/57896/japanese.pdf> .

oid:src-arima-ginsen-radon a onsen:SpringSource ;
    rdfs:label "有馬 銀泉（ラジウム泉）"@ja ;
    onsen:locatedInArea oid:area-arima ;
    onsen:displayedQualityName "単純放射能温泉" ;
    onsen:hasQualityFromName onsen:RadioactiveSpring ;
    onsen:dataStatus """pH・源泉温度・ラドン濃度は未確認。神戸市の市有泉源の紹介は金泉4泉源と炭酸泉源のみで、
銀の湯が使う「山の奥から湧き出るラジウム泉」の泉源は掲載されていない。""" ;
    dcterms:source <https://arimaspa-kingin.jp/gin-01.htm> ,
        <https://www.city.kobe.lg.jp/a64051/arimasengen.html> .

oid:fac-arima-kinnoyu a onsen:Facility ;
    rdfs:label "有馬本温泉 金の湯"@ja ;
    onsen:locatedInArea oid:area-arima ;
    onsen:address "兵庫県神戸市北区有馬町833" ;
    onsen:hasSpringSource oid:src-arima-kinsen ;
    onsen:claimsKakenagashi true ;
    onsen:drinkingPermitted false ;
    rdfs:comment """本オントロジーで isKakenagashi を単一の boolean にしなかった理由そのものの実例。
公式サイトは給排湯形態を「放流式（かけ流し）」と掲示しながら、加水・加温・塩素消毒をすべて実施すると
理由付きで掲示している。「かけ流し」であることは湯が無加工であることを意味しない。"""@ja ;
    onsen:declaresTreatment
        [ a onsen:TreatmentDeclaration ;
          onsen:treatmentType onsen:AddingWater ;
          onsen:isApplied true ;
          onsen:reason "水道水・井戸水を加える" ] ,
        [ a onsen:TreatmentDeclaration ;
          onsen:treatmentType onsen:Heating ;
          onsen:isApplied true ;
          onsen:reason "蒸気による加温" ] ,
        [ a onsen:TreatmentDeclaration ;
          onsen:treatmentType onsen:Recirculation ;
          onsen:isApplied false ;
          onsen:reason "放流式（かけ流し）のため循環させていない" ] ,
        [ a onsen:TreatmentDeclaration ;
          onsen:treatmentType onsen:BathAdditive ;
          onsen:isApplied false ;
          onsen:reason "入浴剤は使用していない" ] ,
        [ a onsen:TreatmentDeclaration ;
          onsen:treatmentType onsen:Disinfection ;
          onsen:isApplied true ;
          onsen:reason "塩素系薬剤による消毒。浴槽は毎日完全に抜き取り清掃" ] ;
    dcterms:source <https://arimaspa-kingin.jp/kin-01.htm> .

oid:fac-arima-ginnoyu a onsen:Facility ;
    rdfs:label "有馬温泉 銀の湯"@ja ;
    onsen:locatedInArea oid:area-arima ;
    onsen:address "兵庫県神戸市北区有馬町1039-1" ;
    onsen:hasSpringSource oid:src-arima-ginsen-co2 , oid:src-arima-ginsen-radon ;
    onsen:claimsKakenagashi false ;
    onsen:declaresTreatment
        [ a onsen:TreatmentDeclaration ;
          onsen:treatmentType onsen:Recirculation ;
          onsen:isApplied true ;
          onsen:reason "循環濾過式（一部放流式）" ] ,
        [ a onsen:TreatmentDeclaration ;
          onsen:treatmentType onsen:AddingWater ;
          onsen:isApplied true ;
          onsen:reason "源泉からの湯量が低下した場合のみ水道水を加える" ] ,
        [ a onsen:TreatmentDeclaration ;
          onsen:treatmentType onsen:Heating ;
          onsen:isApplied true ;
          onsen:reason "熱交換式による加温" ] ,
        [ a onsen:TreatmentDeclaration ;
          onsen:treatmentType onsen:Disinfection ;
          onsen:isApplied true ;
          onsen:reason "消毒を実施" ] ;
    dcterms:source <https://arimaspa-kingin.jp/gin-01.htm> .

#################################################################
#    別府温泉郷 鉄輪 — 本データセットで最も分析情報が揃った例
#################################################################

oid:src-hyotan a onsen:SpringSource ;
    rdfs:label "ひょうたん温泉 源泉"@ja ;
    onsen:locatedInArea oid:area-beppu-kannawa ;
    onsen:displayedQualityName "ナトリウム-塩化物泉（弱酸性低張性高温泉）" ;
    onsen:hasQualityFromName onsen:ChlorideSpring ;
    onsen:mainAnion "Cl-" ;
    onsen:mainCation "Na+" ;
    onsen:pH 3.1 ;
    onsen:sourceTemperature 100.4 ;
    onsen:flowRate 500 ;
    onsen:liquidityClass onsen:WeaklyAcidic ;
    onsen:osmoticClass onsen:Hypotonic ;
    onsen:temperatureClass onsen:HighTemperatureSpring ;
    onsen:measurementPoint onsen:AtSourceOutlet ;
    onsen:analysisDate "1994-02-22"^^xsd:date ;
    onsen:analysisInstitution "大分県衛生環境研究センター" ;
    rdfs:comment "3分類軸（液性・浸透圧・泉温）が掲示泉質名に明示されている数少ない例。推論結果の検算に使える。"@ja ;
    dcterms:source <https://www.hyotan-onsen.com/onsen/> .

oid:fac-hyotan a onsen:Facility ;
    rdfs:label "ひょうたん温泉"@ja ;
    onsen:locatedInArea oid:area-beppu-kannawa ;
    onsen:address "大分県別府市鉄輪159-2" ;
    onsen:hasSpringSource oid:src-hyotan ;
    onsen:claimsKakenagashi true ;
    onsen:drinkingPermitted true ;
    onsen:declaresTreatment
        [ a onsen:TreatmentDeclaration ;
          onsen:treatmentType onsen:AddingWater ;
          onsen:isApplied false ;
          onsen:reason "「湯雨竹（ゆめたけ）」により加水せず自然冷却して源泉十割を維持" ] ,
        [ a onsen:TreatmentDeclaration ;
          onsen:treatmentType onsen:Heating ;
          onsen:isApplied false ;
          onsen:reason "源泉が100.4℃であり加温不要" ] ;
    onsen:dataStatus "循環ろ過・消毒・入浴剤の掲示内容は公式サイト上で未確認。このため isUnmodifiedSupply は導出されない（欠損と否定を区別している）。" ;
    dcterms:source <https://www.hyotan-onsen.com/onsen/> , <https://www.hyotan-onsen.com/access/> .

#################################################################
#    別府温泉郷 明礬
#################################################################

oid:src-okamotoya a onsen:SpringSource ;
    rdfs:label "岡本屋 自噴源泉"@ja ;
    onsen:locatedInArea oid:area-beppu-myoban ;
    onsen:displayedQualityName "酸性・含硫黄-単純温泉（硫化水素型）" ;
    onsen:hasQualityFromName onsen:AcidicSpring , onsen:SulfurSpring , onsen:SimpleSpring ;
    onsen:isHydrogenSulfideType true ;
    onsen:dataStatus "pH・源泉温度は未確認（公式サイトは「酸性湯」との記載のみ）。" ;
    rdfs:comment "特殊成分の付記順位（酸性→含硫黄）が掲示名に現れている例。乳白色は明礬温泉特有の硫黄成分による。"@ja ;
    dcterms:source <https://www.okamotoya.net/onsen/> .

oid:fac-okamotoya a onsen:Facility ;
    rdfs:label "明礬温泉 岡本屋"@ja ;
    onsen:locatedInArea oid:area-beppu-myoban ;
    onsen:address "大分県別府市明礬4組" ;
    onsen:hasSpringSource oid:src-okamotoya ;
    onsen:claimsKakenagashi true ;
    onsen:drinkingPermitted true ;
    onsen:declaresTreatment
        [ a onsen:TreatmentDeclaration ;
