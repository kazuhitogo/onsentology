oid:src-shirahone-awanoyu a onsen:SpringSource ;
    rdfs:label "新泡の湯源泉"@ja ;
    onsen:locatedInArea oid:area-shirahone ;
    onsen:displayedQualityName "含硫黄－カルシウム・マグネシウム－炭酸水素塩温泉（硫化水素型）" ;
    onsen:hasQualityFromName onsen:SulfurSpring , onsen:BicarbonateSpring ;
