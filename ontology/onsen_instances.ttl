#################################################################
#    登別温泉 — 湯使い4類型すべてを否定形で明記した唯一の例
#################################################################

oid:src-noboribetsu-1otsu a onsen:SpringSource ;
    rdfs:label "一号乙泉"@ja ;
    onsen:locatedInArea oid:area-noboribetsu ;
    onsen:displayedQualityName "硫黄泉" ;
    onsen:hasQualityFromName onsen:SulfurSpring ;
    onsen:dataStatus "pH・源泉温度は未確認。公式サイトは「殺菌力が強い強酸性のお湯」と記述するが、水素イオン濃度の数値がないため酸性泉には分類していない。" ;
    dcterms:source <https://sagiriyu-noboribetsu.com/daiyokujou/> .

oid:fac-sagiriyu a onsen:Facility ;
    rdfs:label "登別温泉 さぎり湯"@ja ;
    onsen:locatedInArea oid:area-noboribetsu ;
    onsen:address "北海道登別市登別温泉町60番地" ;
    onsen:hasSpringSource oid:src-noboribetsu-1otsu ;
    onsen:claimsKakenagashi true ;
    rdfs:comment """湯使い4類型（加水／加温／循環（ろ過含む）／消毒処理又は入浴剤使用）すべてについて
「行っていない」と明記している。onsen:isUnmodifiedSupply が推論で導出される数少ない施設。"""@ja ;
    onsen:declaresTreatment
        [ a onsen:TreatmentDeclaration ;
          onsen:treatmentType onsen:AddingWater ;
          onsen:isApplied false ;
          onsen:reason "100%源泉かけ流しのため加水なし" ] ,
        [ a onsen:TreatmentDeclaration ;
          onsen:treatmentType onsen:Heating ;
          onsen:isApplied false ;
          onsen:reason "加温なし" ] ,
        [ a onsen:TreatmentDeclaration ;
          onsen:treatmentType onsen:Recirculation ;
          onsen:isApplied false ;
          onsen:reason "循環（ろ過含む）なし" ] ,
        [ a onsen:TreatmentDeclaration ;
          onsen:treatmentType onsen:Disinfection ;
          onsen:isApplied false ;
          onsen:reason "消毒処理なし" ] ,
        [ a onsen:TreatmentDeclaration ;
          onsen:treatmentType onsen:BathAdditive ;
          onsen:isApplied false ;
          onsen:reason "入浴剤の使用なし" ] ;
    dcterms:source <https://sagiriyu-noboribetsu.com/daiyokujou/> , <https://sagiriyu-noboribetsu.com/yunituite/> .

#################################################################
#    玉川温泉 — 浴槽ごとに源泉比率が異なる例
#################################################################

oid:src-tamagawa a onsen:SpringSource ;
    rdfs:label "玉川温泉 源泉（大噴）"@ja ;
    onsen:locatedInArea oid:area-tamagawa ;
    onsen:displayedQualityName "酸性・含二酸化炭素・鉄（Ⅱ）－塩化物温泉" ;
    onsen:hasQualityFromName onsen:AcidicSpring , onsen:CarbonDioxideSpring ,
        onsen:IronSpring , onsen:ChlorideSpring ;
    onsen:pH 1.2 ;
    onsen:sourceTemperature 97.3 ;
    onsen:flowRate 9360 ;
    onsen:measurementPoint onsen:AtSourceOutlet ;
    onsen:dataStatus """掲示用泉質名は玉川温泉公式の「温泉療養指示書」PDF に印字された表記を採用した。
環境省の八幡平温泉郷 国民保養温泉地計画（平成29年9月改訂）では源泉名「玉川温泉(大墳)」で末尾が「塩化物泉」と表記されており、
公式PDF の「塩化物温泉」と一字異なる。源泉温度97.3℃と湧出量9,360L/min は同計画書の値（施設公式サイトは大噴を「98℃」と記載）。
泉質は掲示泉質名の表記から読み取った（onsen:hasQualityFromName）。「酸性」→酸性泉、「含二酸化炭素」→二酸化炭素泉、
「鉄（Ⅱ）」→含鉄泉、「塩化物」→塩化物泉。成分値（水素イオン濃度 mg/kg 等）は依然として未公表であり、
pH1.2 という液性の値は泉質の判定には使っていない。判定基準は pH ではなく水素イオン 1mg/kg 以上であることに注意。
ラドン濃度は未公表で掲示泉質名にも現れないため、放射能泉に該当するかは分からない（分類しない）。""" ;
    rdfs:comment """成分値が無くても掲示泉質名から泉質を読み取る例。同時に、名称に現れない成分（ラドン）については
分からないと答える例でもある。液性区分（pH1.2 → 酸性）と泉質（酸性泉）は別の指標である。"""@ja ;
    dcterms:source <https://www.tamagawa-onsen.jp/> , <https://www.tamagawa-onsen.jp/care/> ,
        <https://www.tamagawa-onsen.jp/health/pdf/tamagawa_Onsen_Ryouyou_Shijisho.pdf> ,
        <https://www.env.go.jp/nature/onsen/area/pdf/hoyo_005.pdf> .

oid:fac-tamagawa a onsen:Facility ;
    rdfs:label "玉川温泉"@ja ;
    onsen:locatedInArea oid:area-tamagawa ;
    onsen:address "秋田県仙北市田沢湖玉川渋黒沢" ;
    onsen:hasSpringSource oid:src-tamagawa ;
    onsen:drinkingPermitted true ;
    onsen:hasBath oid:bath-tamagawa-100 , oid:bath-tamagawa-50 ;
    rdfs:comment "源泉100%／源泉50%／弱酸性浴槽など11種の浴槽を持つ。飲泉は38倍に薄めて利用する。"@ja ;
    dcterms:source <https://www.tamagawa-onsen.jp/care/> .

oid:bath-tamagawa-100 a onsen:Bath ;
    rdfs:label "源泉100%浴槽"@ja ;
    onsen:bathUsesSource oid:src-tamagawa ;
    onsen:dilutionRatio 1.0 ;
    rdfs:comment "刺激が強いため、ぬるめに温度調整して供されている。"@ja .

oid:bath-tamagawa-50 a onsen:Bath ;
    rdfs:label "源泉50%浴槽"@ja ;
    onsen:bathUsesSource oid:src-tamagawa ;
    onsen:dilutionRatio 0.5 .

