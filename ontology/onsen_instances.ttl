oid:fac-gozenyu a onsen:Facility ;
    rdfs:label "長湯温泉 御前湯（竹田市営）"@ja ;
    onsen:locatedInArea oid:area-nagayu ;
    onsen:address "大分県竹田市直入町長湯7962-1" ;
    onsen:hasSpringSource oid:src-nagayu-1 , oid:src-nagayu-2 , oid:src-nagayu-3 ;
    onsen:claimsKakenagashi true ;
    onsen:drinkingPermitted true ;
    rdfs:comment """「温泉に何も加えず源泉をそのまま利用している」ため館内すべての湯口から飲泉できると説明されている。
長湯温泉全体では利用源泉51本・毎分4,479リットル。"""@ja ;
    onsen:declaresTreatment
        [ a onsen:TreatmentDeclaration ;
          onsen:treatmentType onsen:AddingWater ;
          onsen:isApplied false ;
          onsen:reason "温泉に何も加えず源泉をそのまま利用" ] ,
        [ a onsen:TreatmentDeclaration ;
          onsen:treatmentType onsen:Heating ;
          onsen:isApplied false ;
          onsen:reason "源泉温度47.2℃のため加温不要" ] ,
        [ a onsen:TreatmentDeclaration ;
          onsen:treatmentType onsen:Recirculation ;
          onsen:isApplied false ;
          onsen:reason "源泉をそのまま利用" ] ,
        [ a onsen:TreatmentDeclaration ;
          onsen:treatmentType onsen:Disinfection ;
          onsen:isApplied false ;
          onsen:reason "温泉に何も加えていない" ] ,
        [ a onsen:TreatmentDeclaration ;
          onsen:treatmentType onsen:BathAdditive ;
          onsen:isApplied false ;
          onsen:reason "温泉に何も加えていない" ] ;
    dcterms:source <https://gozenyu.com/onsen.html> .

#################################################################
#    鳴子温泉 — 旧泉質名のみ公表されている例
#################################################################

oid:src-naruko-takinoyu a onsen:SpringSource ;
    rdfs:label "鳴子 滝の湯 源泉"@ja ;
    onsen:locatedInArea oid:area-naruko ;
    onsen:legacyQualityName "酸性含明礬・緑礬-芒硝硫化水素泉" ;
    onsen:hasQualityFromName onsen:AcidicSpring , onsen:SulfateSpring , onsen:SulfurSpring ;
    onsen:pH 2.9 ;
    onsen:dataStatus """公表されているのは旧泉質名のみ。掲示用泉質への対応づけは旧泉質名の表記からの読み取りであり
（onsen:hasQualityFromName）、施設の掲示内容そのものではない（酸性→酸性泉、明礬・緑礬／芒硝→硫酸塩泉、硫化水素→硫黄泉）。
成分値・源泉温度・湯使いは未確認。""" ;
    dcterms:source <https://narukoonsenkyo.web.fc2.com/takinoyu/index.html> .

oid:fac-takinoyu a onsen:Facility ;
    rdfs:label "鳴子温泉 滝の湯"@ja ;
    onsen:locatedInArea oid:area-naruko ;
