    onsen:pH 6.3 ;
    onsen:sourceTemperature 37.3 ;
    onsen:flowRate 1730 ;
    onsen:measurementPoint onsen:AtSourceOutlet ;
    onsen:analysisDate "2007-06-26"^^xsd:date ;
