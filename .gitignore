# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# ローカル設定（アカウント固有の ARN やプロファイル名を含む）
.env

# 推論結果キャッシュ
.cache/

# pytest
.pytest_cache/
.ruff_cache/

# 記事本文（note.com に投稿する原稿）と作業用ドキュメント。リポジトリには含めない。
articles/
HANDOVER.md
HISTORY.md
PLAN.md

# 効果検証の実測結果（Bedrock を実際に呼んだ記録）は **コミットする**。
# 記事の数字を後から誰でも再集計できるようにするため。ただしモデル ARN には
# アカウント ID が入るので、scripts/sanitize-eval-results.py でモデル名に置換してから入れる。
# 実行時に作る集計の副産物（*.summary.json）は再生成できるので置かない。
eval-results/*.summary.json

# 比較実験用のコーパス（環境省の通知と各施設の公表ページの本文）。
# 第三者の著作物なので再配布はしない。uv run onsen corpus build で組み直せる。
corpus/

# 揃えた生ドキュメント（比較条件F）。グラフから生成できるので置かない。
# uv run onsen corpus align で作り直せる。
corpus-aligned/

# onsen graph の出力（図はリポジトリに置かない）
*.png
*.svg
*.dot
